{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["entries"],
  "properties": {
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["squadName", "veterancyTier"],
        "properties": {
          "squadName": { "type": "string", "minLength": 1 },
          "veterancyTier": { "type": "integer", "minimum": 0, "maximum": 4 }
        }
      }
    }
  }
}
