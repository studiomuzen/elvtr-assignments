{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["nodes"],
  "properties": {
    "nodes": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "branch", "tier", "name", "unlocks", "prereqs", "state", "remainingDays"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "branch": {
            "type": "string",
            "enum": ["Drones and missiles", "Infantry", "Vehicles", "Economy"]
          },
          "tier": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "unlocks": {
            "type": "string",
            "minLength": 1
          },
          "prereqs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "state": {
            "type": "string",
            "enum": ["locked", "available", "researching", "done"]
          },
          "remainingDays": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
