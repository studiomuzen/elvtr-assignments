@@ -0,0 +1,58 @@
+using UnityEngine;
+
+namespace Ambush.Game
+{
+    /// <summary>Why a day was lost (GDD 02 § How a day is won or lost).</summary>
+    public enum DayLossReason
+    {
+        None,
+        CentreHeld
+    }
+
+    /// <summary>
+    /// GDD 02 "Day lost: centre held": the checker adds a TownCentreZone (FeatureFlags.TownCentreHold)
+    /// and ends the battle as EnemyWins when the zone raises OnCentreHeld.
+    /// </summary>
+    public partial class BattleEndChecker
+    {
+        public const string CentreHeldLogPrefix = "[BattleEnd] Enemy wins — town centre held";
+        public const string CentreHeldMessage = "DAY LOST — the enemy holds the town centre.";
+
+        /// <summary>CentreHeld when the day ended on the town-centre rule, else None.</summary>
+        public DayLossReason DayLoss { get; private set; }
+        public TownCentreZone TownCentre => _townCentre;
+
+        private TownCentreZone _townCentre;
+
+        private void HookTownCentre()
+        {
+            if (!FeatureFlags.TownCentreHold) return;
+            _townCentre = GetComponent<TownCentreZone>();
+            if (_townCentre == null) _townCentre = gameObject.AddComponent<TownCentreZone>();
+            _townCentre.OnCentreHeld -= HandleCentreHeld;
+            _townCentre.OnCentreHeld += HandleCentreHeld;
+            battleEndedEvent.AddListener(HaltTownCentre);
+        }
+
+        private void HaltTownCentre(BattleOutcome outcome)
+        {
+            if (_townCentre != null) _townCentre.Halt();
+        }
+
+        private void HandleCentreHeld()
+        {
+            if (HasFired) return;
+            if (pollCoroutine != null)
+            {
+                StopCoroutine(pollCoroutine); // no second outcome from the poll loop
+                pollCoroutine = null;
+            }
+            float s = _townCentre != null ? _townCentre.HoldSeconds : TownCentreZone.DefaultHoldSeconds;
+            Debug.Log($"{CentreHeldLogPrefix} for {s:0} s.");
+            DayLoss = DayLossReason.CentreHeld;
+            HasFired = true;
+            Ambush.UI.EventLog.Post(CentreHeldMessage, true);
+            battleEndedEvent.Invoke(BattleOutcome.EnemyWins);
+        }
+    }
+}
