+++ b/ELVATR GAME 1/Assets/Scripts/Game/TownCentreZone.cs	
@@ -0,0 +1,136 @@
+using System;
+using System.Collections.Generic;
+using UnityEngine;
+using Ambush.Units;
+
+namespace Ambush.Game
+{
+    /// <summary>
+    /// GDD 02 § How a day is won or lost: "Day lost: centre held" — Russian infantry is inside the
+    /// town centre and no living Ukrainian soldier is inside it for <see cref="DefaultHoldSeconds"/>
+    /// in a row. Each frame the zone reads UnitRegistry.AliveSoldiers for both sides and reports
+    /// <see cref="RussianInside"/> / <see cref="UkrainianInside"/>; centreTimer counts up only while
+    /// Russians hold it uncontested and resets to zero otherwise. At the hold duration it raises
+    /// <see cref="OnCentreHeld"/> exactly once (BattleEndChecker records the day loss; CountdownHud
+    /// shows the remaining seconds). Added by BattleEndChecker behind FeatureFlags.TownCentreHold.
+    ///
+    /// No level data names a town centre yet, so the zone is a square of halfSizeM around the centre
+    /// of the playable area (BattleEndChecker.PlayableBounds); <see cref="SetZone"/> overrides it.
+    /// </summary>
+    public class TownCentreZone : MonoBehaviour
+    {
+        public const float DefaultHoldSeconds = 60f;
+        public const float DefaultHalfSizeM = 50f;
+
+        [SerializeField] private float holdSeconds = DefaultHoldSeconds;
+        [SerializeField] private float halfSizeM = DefaultHalfSizeM;
+
+        /// <summary>The zone on screen now (null without one, e.g. Setup or test scenes).</summary>
+        public static TownCentreZone Current { get; private set; }
+
+        /// <summary>Raised once, when centreTimer reaches the hold duration.</summary>
+        public event Action OnCentreHeld;
+
+        private float centreTimer;
+        private Vector2 _min, _max;
+        private bool _zoneSet;
+        private bool _halted;
+        private readonly List<SoldierBehavior> _buffer = new List<SoldierBehavior>(256);
+
+        public float HoldSeconds => holdSeconds;
+        /// <summary>Seconds Russian infantry has held the centre uncontested, in a row.</summary>
+        public float CentreTimer => centreTimer;
+        public float RemainingSeconds => Mathf.Max(0f, holdSeconds - centreTimer);
+        public bool RussianInside { get; private set; }
+        public bool UkrainianInside { get; private set; }
+        public bool HasHeld { get; private set; }
+        /// <summary>True while the countdown runs (timer above zero, not yet held).</summary>
+        public bool IsCounting => centreTimer > 0f && !HasHeld && !_halted;
+        public Vector2 MinXZ => _min;
+        public Vector2 MaxXZ => _max;
+        /// <summary>Tests drive <see cref="Tick"/> themselves; Update then does nothing.</summary>
+        public bool ManualTick { get; set; }
+
+        [RuntimeInitializeOnLoadMethod(RuntimeInitializeLoadType.SubsystemRegistration)]
+        private static void ResetOnPlay() => Current = null;
+
+        private void OnEnable() => Current = this;
+
+        private void OnDisable()
+        {
+            if (Current == this) Current = null;
+        }
+
+        /// <summary>Sets the centre box in world XZ (min / max corners).</summary>
+        public void SetZone(Vector2 min, Vector2 max)
+        {
+            _min = Vector2.Min(min, max);
+            _max = Vector2.Max(min, max);
+            _zoneSet = true;
+        }
+
+        private void ResolveZone()
+        {
+            BattleEndChecker.PlayableBounds(out Vector2 min, out Vector2 max);
+            Vector2 c = (min + max) * 0.5f;
+            Vector2 h = new Vector2(halfSizeM, halfSizeM);
+            SetZone(c - h, c + h);
+        }
+
+        public bool Contains(Vector3 pos) =>
+            pos.x >= _min.x && pos.x <= _max.x && pos.z >= _min.y && pos.z <= _max.y;
+
+        /// <summary>Stops the countdown (battle over by another rule); the HUD hides.</summary>
+        public void Halt()
+        {
+            _halted = true;
+            if (!HasHeld) centreTimer = 0f;
+        }
+
+        private void Update()
+        {
+            if (ManualTick || _halted) return;
+            if (!FeatureFlags.TownCentreHold) { centreTimer = 0f; return; }
+            var flow = BattleFlow.Instance;
+            if (flow != null && !flow.HasBattleStarted) { centreTimer = 0f; return; }
+            Tick(Time.deltaTime);
+        }
+
+        /// <summary>Reads who is inside, then advances or resets centreTimer by <paramref name="dt"/>.</summary>
+        public void Tick(float dt)
+        {
+            if (HasHeld || _halted) return;
+            if (!_zoneSet) ResolveZone();
+
+            RussianInside = AnyInside(Faction.Enemy);
+            UkrainianInside = AnyInside(Faction.Player);
+
+            if (!RussianInside || UkrainianInside)
+            {
+                centreTimer = 0f;
+                return;
+            }
+
+            centreTimer += Mathf.Max(0f, dt);
+            if (centreTimer >= holdSeconds)
+            {
+                centreTimer = holdSeconds;
+                HasHeld = true;
+                Debug.Log($"[TownCentre] held by Russian infantry for {holdSeconds:0} s");
+                OnCentreHeld?.Invoke();
+            }
+        }
+
+        private bool AnyInside(Faction faction)
+        {
+            UnitRegistry.AliveSoldiers(faction, _buffer);
+            bool any = false;
+            for (int i = 0; i < _buffer.Count; i++)
+            {
+                if (Contains(_buffer[i].transform.position)) { any = true; break; }
+            }
+            _buffer.Clear();
+            return any;
+        }
+    }
+}
