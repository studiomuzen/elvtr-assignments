@@ -0,0 +1,95 @@
+using TMPro;
+using UnityEngine;
+using UnityEngine.UI;
+using Ambush.Game;
+
+namespace Ambush.UI
+{
+    /// <summary>
+    /// GDD 02 "Day lost: centre held (HUD countdown)": while TownCentreZone's centreTimer runs, a
+    /// label under the top bar shows the seconds left (hold duration minus centreTimer); it is
+    /// hidden whenever the timer is reset. Built by HudFrame (FeatureFlags.TownCentreHold).
+    /// The label is a TextMeshProUGUI when the TMP Settings resource ships; without it TMP would
+    /// throw in a player build, so the HUD's legacy Text in the pixel font is used instead.
+    /// </summary>
+    public class CountdownHud : MonoBehaviour
+    {
+        public const string RootName = "CentreCountdown";
+        public const string LabelName = "CentreCountdownLabel";
+
+        private GameObject _root;
+        private TextMeshProUGUI _tmp;
+        private Text _legacy;
+        private bool _visible;
+        private int _shownSecs = -1;
+
+        public bool IsVisible => _visible;
+        /// <summary>The countdown text on screen now (null until built).</summary>
+        public string Shown => _tmp != null ? _tmp.text : _legacy != null ? _legacy.text : null;
+
+        public static string CountdownText(int secs) => $"CENTRE FALLS IN {secs} s";
+
+        /// <summary>Builds the (hidden) countdown panel under <paramref name="parent"/>, once.</summary>
+        public void Build(RectTransform parent)
+        {
+            if (_root != null || parent == null) return;
+            var rt = NewRect(RootName, parent, new Vector2(0.38f, 0.875f), new Vector2(0.62f, 0.935f));
+            _root = rt.gameObject;
+            var bg = _root.AddComponent<Image>();
+            bg.color = new Color(HudFrame.PanelColor.r, HudFrame.PanelColor.g, HudFrame.PanelColor.b, 0.85f);
+            bg.raycastTarget = false;
+
+            var labelRt = NewRect(LabelName, rt, Vector2.zero, Vector2.one);
+            if (Resources.Load<TMP_Settings>("TMP Settings") != null)
+            {
+                _tmp = labelRt.gameObject.AddComponent<TextMeshProUGUI>();
+                _tmp.fontSize = 18;
+                _tmp.color = HudFrame.Salmon;
+                _tmp.alignment = TextAlignmentOptions.Center;
+                _tmp.raycastTarget = false;
+            }
+            else
+            {
+                _legacy = labelRt.gameObject.AddComponent<Text>();
+                _legacy.font = HudFrame.DisplayFont;
+                _legacy.fontSize = 14;
+                _legacy.color = HudFrame.Salmon;
+                _legacy.alignment = TextAnchor.MiddleCenter;
+                _legacy.horizontalOverflow = HorizontalWrapMode.Overflow;
+                _legacy.raycastTarget = false;
+            }
+            _root.SetActive(false);
+            _visible = false;
+        }
+
+        private void Update()
+        {
+            var zone = TownCentreZone.Current;
+            bool show = FeatureFlags.TownCentreHold && zone != null && zone.IsCounting;
+            if (show != _visible)
+            {
+                _visible = show;
+                if (_root != null) _root.SetActive(show);
+                if (!show) _shownSecs = -1;
+            }
+            if (!show) return;
+
+            int secs = Mathf.Max(0, Mathf.CeilToInt(zone.HoldSeconds - zone.CentreTimer));
+            if (secs == _shownSecs) return; // a new string only once a second
+            _shownSecs = secs;
+            string text = CountdownText(secs);
+            if (_tmp != null) _tmp.text = text;
+            if (_legacy != null) _legacy.text = text;
+        }
+
+        private static RectTransform NewRect(string name, Transform parent, Vector2 min, Vector2 max)
+        {
+            var rt = (RectTransform)new GameObject(name, typeof(RectTransform)).transform;
+            rt.SetParent(parent, false);
+            rt.anchorMin = min;
+            rt.anchorMax = max;
+            rt.offsetMin = rt.offsetMax = Vector2.zero;
+            return rt;
+        }
+    }
+}
