diff --git a/ELVATR GAME 1/Assets/Tests/PlayMode/TownCentreHoldTest.cs b/ELVATR GAME 1/Assets/Tests/PlayMode/TownCentreHoldTest.cs
new file mode 100644
index 000000000..840c204d9
--- /dev/null
+++ b/ELVATR GAME 1/Assets/Tests/PlayMode/TownCentreHoldTest.cs	
@@ -0,0 +1,211 @@
+using System;
+using System.Collections;
+using System.Reflection;
+using NUnit.Framework;
+using UnityEngine;
+using UnityEngine.SceneManagement;
+using UnityEngine.TestTools;
+using Object = UnityEngine.Object;
+
+namespace Ambush.Tests.PlayMode
+{
+    /// <summary>
+    /// GDD 02 "Day lost: centre held": TownCentreZone's centreTimer advances while Russian infantry
+    /// is alone in the zone, resets to zero when a Ukrainian soldier enters, and OnCentreHeld fires
+    /// exactly once after 60 s. The zone is ticked by hand (ManualTick) in a scene far from any
+    /// other unit. Reflection only (the test asmdef does not reference Assembly-CSharp).
+    /// </summary>
+    public class TownCentreHoldTest
+    {
+        private const BindingFlags AnyInstance = BindingFlags.Instance | BindingFlags.Public | BindingFlags.NonPublic;
+        private static readonly Vector3 Origin = new Vector3(-80000f, 0f, 80000f);
+
+        private static Type RequireType(string fullName)
+        {
+            foreach (var a in AppDomain.CurrentDomain.GetAssemblies())
+            {
+                var t = a.GetType(fullName, throwOnError: false);
+                if (t != null) return t;
+            }
+            Assert.Fail($"{fullName} type not found.");
+            return null;
+        }
+
+        private static void Set(object target, string field, object value)
+        {
+            var f = target.GetType().GetField(field, AnyInstance);
+            Assert.IsNotNull(f, $"{target.GetType().Name}.{field} not found.");
+            if (f.FieldType.IsEnum && value is string s) value = Enum.Parse(f.FieldType, s);
+            f.SetValue(target, value);
+        }
+
+        private static object Prop(object target, string name) =>
+            target.GetType().GetProperty(name, AnyInstance).GetValue(target);
+
+        private static GameObject SpawnSoldier(Type healthType, Type soldierType, string faction, Vector3 pos)
+        {
+            var go = new GameObject("TownCentre_" + faction);
+            go.SetActive(false);
+            go.transform.position = pos;
+            var h = go.AddComponent(healthType);
+            var b = go.AddComponent(soldierType);
+            go.SetActive(true); // Awake + OnEnable (registers in UnitRegistry)
+            healthType.GetMethod("Initialize", BindingFlags.Public | BindingFlags.Instance).Invoke(h, new object[] { 100f });
+            Set(b, "selfFaction", faction);
+            Set(b, "damagePerSecond", 0f);
+            Set(b, "damagePerHit", 0f);
+            Set(b, "moveSpeed", 0f);
+            return go;
+        }
+
+        [UnityTest]
+        public IEnumerator CentreTimer_AdvancesAlone_ResetsOnUkrainian_FiresOnCentreHeldOnceAt60s()
+        {
+            var zoneType = RequireType("Ambush.Game.TownCentreZone");
+            var soldierType = RequireType("Ambush.Units.SoldierBehavior");
+            var healthType = RequireType("Ambush.Units.SoldierHealth");
+
+            var scene = SceneManager.CreateScene("TownCentreHoldTest_" + Time.frameCount);
+            var prevActive = SceneManager.GetActiveScene();
+            SceneManager.SetActiveScene(scene);
+            LogAssert.ignoreFailingMessages = true;
+            try
+            {
+                var zoneGo = new GameObject("TownCentreZone");
+                var zone = zoneGo.AddComponent(zoneType);
+                zoneType.GetProperty("ManualTick").SetValue(zone, true);
+                zoneType.GetMethod("SetZone").Invoke(zone, new object[]
+                {
+                    new Vector2(Origin.x - 10f, Origin.z - 10f), new Vector2(Origin.x + 10f, Origin.z + 10f)
+                });
+                var tick = zoneType.GetMethod("Tick");
+                int held = 0;
+                zoneType.GetEvent("OnCentreHeld").AddEventHandler(zone, (Action)(() => held++));
+                float hold = (float)Prop(zone, "HoldSeconds");
+                Assert.AreEqual(60f, hold, 0.001f, "The town centre hold is 60 s.");
+                float Timer() => (float)Prop(zone, "CentreTimer");
+
+                // Empty zone: no countdown.
+                tick.Invoke(zone, new object[] { 1f });
+                Assert.AreEqual(0f, Timer(), "centreTimer must stay 0 with nobody inside.");
+
+                // Russian infantry alone: the timer advances.
+                var russian = SpawnSoldier(healthType, soldierType, "Enemy", Origin);
+                yield return null;
+                for (int i = 0; i < 10; i++) tick.Invoke(zone, new object[] { 1f });
+                Assert.IsTrue((bool)Prop(zone, "RussianInside"), "Russian soldier should be reported inside.");
+                Assert.IsFalse((bool)Prop(zone, "UkrainianInside"), "No Ukrainian soldier inside yet.");
+                Assert.AreEqual(10f, Timer(), 0.001f, "centreTimer should advance with Russian infantry alone in the zone.");
+                Assert.IsTrue((bool)Prop(zone, "IsCounting"), "Countdown should be running.");
+
+                // A Ukrainian soldier enters: the timer resets to zero.
+                var ukrainian = SpawnSoldier(healthType, soldierType, "Player", Origin + new Vector3(2f, 0f, 2f));
+                yield return null;
+                tick.Invoke(zone, new object[] { 1f });
+                Assert.IsTrue((bool)Prop(zone, "UkrainianInside"), "Ukrainian soldier should be reported inside.");
+                Assert.AreEqual(0f, Timer(), "centreTimer must reset when a Ukrainian soldier is inside.");
+                Assert.IsFalse((bool)Prop(zone, "IsCounting"), "Countdown must stop when contested.");
+
+                // He leaves the map: 59 s is not enough, 60 s fires OnCentreHeld once.
+                Object.Destroy(ukrainian);
+                yield return null;
+                for (int i = 0; i < 59; i++) tick.Invoke(zone, new object[] { 1f });
+                Assert.AreEqual(59f, Timer(), 0.001f, "centreTimer should count again from zero.");
+                Assert.AreEqual(0, held, "OnCentreHeld fired before 60 s.");
+                tick.Invoke(zone, new object[] { 1f });
+                Assert.AreEqual(1, held, "OnCentreHeld should fire when centreTimer reaches 60 s.");
+                Assert.IsTrue((bool)Prop(zone, "HasHeld"), "Zone should report the centre as held.");
+                for (int i = 0; i < 5; i++) tick.Invoke(zone, new object[] { 1f });
+                Assert.AreEqual(1, held, "OnCentreHeld must fire exactly once.");
+
+                Object.Destroy(zoneGo);
+                Object.Destroy(russian);
+                yield return null;
+            }
+            finally
+            {
+                LogAssert.ignoreFailingMessages = false;
+                if (prevActive.IsValid()) SceneManager.SetActiveScene(prevActive);
+            }
+
+            var unload = SceneManager.UnloadSceneAsync(scene);
+            while (unload != null && !unload.isDone) yield return null;
+        }
+
+        /// <summary>
+        /// CountdownHud: hidden with nobody in the zone, shows the seconds left (hold minus centreTimer)
+        /// while Russian infantry holds it alone, hides when a Ukrainian soldier resets the timer, and
+        /// hides again once OnCentreHeld has fired.
+        /// </summary>
+        [UnityTest]
+        public IEnumerator CountdownHud_ShowsRemainingSeconds_HidesOnReset_AndAfterOnCentreHeld()
+        {
+            var zoneType = RequireType("Ambush.Game.TownCentreZone");
+            var hudType = RequireType("Ambush.UI.CountdownHud");
+            var soldierType = RequireType("Ambush.Units.SoldierBehavior");
+            var healthType = RequireType("Ambush.Units.SoldierHealth");
+
+            var scene = SceneManager.CreateScene("CountdownHudTest_" + Time.frameCount);
+            var prevActive = SceneManager.GetActiveScene();
+            SceneManager.SetActiveScene(scene);
+            LogAssert.ignoreFailingMessages = true;
+            try
+            {
+                var zoneGo = new GameObject("TownCentreZone");
+                var zone = zoneGo.AddComponent(zoneType);
+                zoneType.GetProperty("ManualTick").SetValue(zone, true);
+                zoneType.GetMethod("SetZone").Invoke(zone, new object[]
+                {
+                    new Vector2(Origin.x - 10f, Origin.z - 10f), new Vector2(Origin.x + 10f, Origin.z + 10f)
+                });
+                var tick = zoneType.GetMethod("Tick");
+                int held = 0;
+                zoneType.GetEvent("OnCentreHeld").AddEventHandler(zone, (Action)(() => held++));
+
+                var canvasGo = new GameObject("CountdownHudTestCanvas", typeof(RectTransform), typeof(Canvas));
+                var hud = canvasGo.AddComponent(hudType);
+                hudType.GetMethod("Build").Invoke(hud, new object[] { (RectTransform)canvasGo.transform });
+                bool Visible() => (bool)Prop(hud, "IsVisible");
+                string Shown() => (string)Prop(hud, "Shown");
+
+                tick.Invoke(zone, new object[] { 1f });
+                yield return null;
+                Assert.IsFalse(Visible(), "CountdownHud must be hidden with nobody in the centre.");
+
+                var russian = SpawnSoldier(healthType, soldierType, "Enemy", Origin);
+                yield return null;
+                for (int i = 0; i < 5; i++) tick.Invoke(zone, new object[] { 1f });
+                yield return null;
+                Assert.IsTrue(Visible(), "CountdownHud must show while Russian infantry holds the centre alone.");
+                StringAssert.Contains("55", Shown(), "CountdownHud should show 60 - centreTimer = 55 s.");
+
+                var ukrainian = SpawnSoldier(healthType, soldierType, "Player", Origin + new Vector3(2f, 0f, 2f));
+                yield return null;
+                tick.Invoke(zone, new object[] { 1f });
